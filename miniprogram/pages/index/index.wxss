.app {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ===== 顶栏 ===== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  column-gap: 40rpx;
  row-gap: 12rpx;
  flex-wrap: wrap;
  padding: 20rpx 32rpx;
  background: #1e293b;
  flex-shrink: 0;
  border-bottom: 3rpx solid #2563eb;
}

.stat {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}


.stat .label {
  color: #94a3b8;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
}

.stat .label.dim {
  margin: 0 8rpx;
  color: #64748b;
  font-size: 28rpx;
}

.stat .label.gap {
  margin-left: 28rpx;
}

.stat .value {
  color: #f1f5f9;
  font-weight: 700;
  font-size: 34rpx;
  margin-left: 8rpx;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.stat .value.green {
  color: #4ade80;
}

/* ===== 模式切换（分段控件） ===== */
.mode-toggle {
  display: flex;
  background: #0f172a;
  border: 1rpx solid #334155;
  border-radius: 14rpx;
  padding: 6rpx;
  gap: 4rpx;
}

.mode-btn {
  padding: 10rpx 20rpx;
  color: #94a3b8;
  border-radius: 12rpx;
  line-height: 1.3;
  font-weight: 500;
  transition: all 0.2s ease;
  white-space: nowrap;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ico {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.mode-btn.active {
  background: #2563eb;
  color: #ffffff;
  font-weight: 700;
}

.mode-btn.active-amber {
  background: #d97706;
  color: #ffffff;
  font-weight: 700;
}

.bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 100%;
  min-width: 0;
}

.new-btn {
  padding: 10rpx 20rpx;
  color: #4ade80;
  border: 1rpx solid rgba(74, 222, 128, 0.4);
  border-radius: 12rpx;
  background: rgba(74, 222, 128, 0.08);
  font-weight: 600;
  white-space: nowrap;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-btn {
  padding: 10rpx 20rpx;
  color: #cbd5e1;
  border: 1rpx solid rgba(203, 213, 225, 0.4);
  border-radius: 12rpx;
  background: rgba(203, 213, 225, 0.08);
  white-space: nowrap;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-btn:active {
  background: rgba(203, 213, 225, 0.18);
}

.new-btn:active {
  background: rgba(74, 222, 128, 0.18);
}

/* ===== 场景画布 ===== */
.canvas-wrap {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 0;
}

.scene-canvas {
  width: 100%;
  height: 100%;
}

.feedback {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 140rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  text-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  pointer-events: none;
  z-index: 30;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif;
}

.feedback.correct {
  color: #16a34a;
}

.feedback.wrong {
  color: #dc2626;
}

/* ===== 首次引导提示 ===== */
.hint-text {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(37, 99, 235, 0.9);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  letter-spacing: 2rpx;
  pointer-events: none;
  z-index: 25;
  white-space: nowrap;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  animation: hintPulse 2s ease-in-out infinite;
}

@keyframes hintPulse {
  0%, 100% { opacity: 0.9; transform: translateX(-50%) scale(1); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.03); }
}

.countdown-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #ef4444);
  width: 100%;
  transform-origin: left;
  box-shadow: 0 0 20rpx rgba(245, 158, 11, 0.5);
}

.divider-bar {
  flex-shrink: 0;
  height: 6rpx;
  background: #cbd5e1;
  position: relative;
  overflow: hidden;
}

/* ===== 摇杆区 ===== */
.tx-wrap {
  flex-shrink: 0;
  height: 480rpx;
  position: relative;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(37, 99, 235, 0.12);
}

.tx-canvas {
  width: 100%;
  height: 100%;
}

/* ===== 答案弹层 ===== */
.answer-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.682);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 60rpx;
}

.card {
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-left: 8rpx solid #dc2626;
  border-radius: 20rpx;
  padding: 40rpx 48rpx;
  text-align: center;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.15);
}

.card .title {
  font-size: 34rpx;
  font-weight: 700;
  color: #dc2626;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.card .desc {
  font-size: 30rpx;
  color: #334155;
  line-height: 1.7;
  font-weight: 400;
}

.card.card-wrong {
  border-left-color: #dc2626;
}

.card.card-timeout {
  border-left-color: #f59e0b;
}

.card.card-timeout .title {
  color: #d97706;
}

.card .desc .hl {
  color: #16a34a;
  font-weight: 700;
  font-size: 34rpx;
}

.ok-btn {
  align-self: center;
  background: #2563eb;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  padding: 28rpx 120rpx;
  border-radius: 48rpx;
  letter-spacing: 4rpx;
  min-width: 300rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(37, 99, 235, 0.35);
}

.ok-btn:active {
  background: #1d4ed8;
  transform: scale(0.97);
}
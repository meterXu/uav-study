.app {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background: linear-gradient(180deg, #16213e 0%, #0f3460 40%, #1a1a2e 100%);
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.4);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.stat {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.label {
  color: #8899aa;
}

.label.dim {
  margin: 0 4rpx;
  color: #555566;
}

.label.gap {
  margin-left: 12rpx;
}

.value {
  color: #fff;
  font-weight: 600;
  margin-left: 4rpx;
}

.value.green {
  color: #4ade80;
}

.mode-toggle {
  display: flex;
}

.mode-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  color: #8899aa;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
}

.mode-btn.active {
  background: #4361ee;
  color: #fff;
  border-color: #4361ee;
}

.mode-btn:first-child {
  border-radius: 10rpx 0 0 10rpx;
}

.mode-btn:last-child {
  border-radius: 0 10rpx 10rpx 0;
}

.canvas-wrap {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 0;
}

.scene-canvas {
  width: 100%;
  height: 100%;
}

.feedback {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 96rpx;
  font-weight: 900;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.6);
  pointer-events: none;
}

.feedback.correct {
  color: #4ade80;
}

.feedback.wrong {
  color: #f87171;
}

.countdown-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 10rpx;
  background: linear-gradient(90deg, #f87171, #fb923c);
  width: 100%;
  transform-origin: left;
}

.tx-wrap {
  flex-shrink: 0;
  height: 400rpx;
  position: relative;
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  border-top: 2rpx solid rgba(255, 255, 255, 0.06);
}

.tx-canvas {
  width: 100%;
  height: 100%;
}

.answer-overlay {
  position: absolute;
  top: 112rpx;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.card {
  background: rgba(20, 28, 45, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.5);
}

.card .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f87171;
  margin-bottom: 12rpx;
}

.card .desc {
  font-size: 26rpx;
  color: #d5dee8;
  line-height: 1.5;
}

.card .desc .hl {
  color: #4ade80;
  font-weight: 700;
}

.ok-btn {
  align-self: center;
  background: #4361ee;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 80rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(67, 97, 238, 0.4);
}

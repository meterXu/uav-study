.app {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background: linear-gradient(180deg, #0b1220 0%, #0a0f1a 100%);
}

/* ===== 顶栏 ===== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: #0f172a;
  border-bottom: 1rpx solid #1e293b;
  flex-shrink: 0;
}

.stat {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
}

.stat .label {
  color: #64748b;
  font-size: 22rpx;
}

.stat .label.dim {
  margin: 0 6rpx;
  color: #334155;
}

.stat .label.gap {
  margin-left: 20rpx;
}

.stat .value {
  color: #f1f5f9;
  font-weight: 700;
  font-size: 28rpx;
  margin-left: 6rpx;
  font-family: 'DIN Alternate', 'SF Mono', Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.stat .value.green {
  color: #22c55e;
}

/* ===== 模式切换（分段控件） ===== */
.mode-toggle {
  display: flex;
  background: #1e293b;
  border: 1rpx solid #26334a;
  border-radius: 12rpx;
  padding: 4rpx;
}

.mode-btn {
  padding: 8rpx 26rpx;
  font-size: 22rpx;
  color: #94a3b8;
  border-radius: 9rpx;
  line-height: 1.4;
}

.mode-btn.active {
  background: #0ea5e9;
  color: #082f49;
  font-weight: 700;
}

.mode-btn.active-amber {
  background: #f59e0b;
  color: #431407;
  font-weight: 700;
}

/* ===== 场景画布 ===== */
.canvas-wrap {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 0;
}

.scene-canvas {
  width: 100%;
  height: 100%;
}

.feedback {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 104rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  text-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.7);
  pointer-events: none;
}

.feedback.correct {
  color: #22c55e;
}

.feedback.wrong {
  color: #ef4444;
}

.countdown-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #f59e0b, #ef4444);
  width: 100%;
  transform-origin: left;
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.5);
}

/* ===== 摇杆区 ===== */
.tx-wrap {
  flex-shrink: 0;
  height: 400rpx;
  position: relative;
  background: #111827;
  border-top: 1rpx solid #1e293b;
}

.tx-canvas {
  width: 100%;
  height: 100%;
}

/* ===== 答案弹层 ===== */
.answer-overlay {
  position: absolute;
  top: 128rpx;
  left: 0;
  right: 0;
  background: rgba(2, 6, 23, 0.72);
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 32rpx 36rpx;
}

.card {
  background: #0f172a;
  border: 1rpx solid #26334a;
  border-left: 6rpx solid #ef4444;
  border-radius: 16rpx;
  padding: 28rpx 36rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.6);
}

.card .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f87171;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.card .desc {
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.6;
}

.card .desc .hl {
  color: #4ade80;
  font-weight: 700;
  font-size: 30rpx;
}

.ok-btn {
  align-self: center;
  background: #0ea5e9;
  color: #082f49;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 96rpx;
  border-radius: 44rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.35);
}

.ok-btn:active {
  background: #0284c7;
}
